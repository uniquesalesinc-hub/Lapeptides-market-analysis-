# Copy this file to .env (local dev) or configure these as environment variables in your
# hosting provider (Vercel, etc). Never commit a real .env file — it is already gitignored.

# --- Database (required) ---
# PostgreSQL connection string. Works with Supabase, Neon, Railway, RDS, or local Postgres.
# Supabase: Project Settings -> Database -> Connection string -> "URI" (use the pooled
# "Transaction" connection string for DATABASE_URL, and the direct connection for DIRECT_URL
# if you enable Prisma's connection pooling in prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/lapeptides_sales_portal?schema=public"

# --- Auth.js / NextAuth (required) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional — architecture is ready, not yet wired into src/auth.ts) ---
# Uncomment and add a Google provider in src/auth.ts once these are supplied.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Transactional email (optional but recommended) ---
# Without this, password-reset and quote/invoice "send" actions log to the server console
# instead of delivering mail — the app tells the user honestly rather than faking success.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="LA Peptides Sales Portal <no-reply@lapeptides.net>"

# --- File storage (optional — for uploaded pricing sheets / product images) ---
# Any S3-compatible provider works (Supabase Storage, AWS S3, Cloudflare R2, etc).
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Payments (not implemented — do not add fake credentials here) ---
# The invoice data model is prepared for future ACH payment integration (see
# docs/PRICING_AUDIT.md and README "Remaining integrations"). No payment processor is wired up.
# ACH_PROVIDER_API_KEY=""
