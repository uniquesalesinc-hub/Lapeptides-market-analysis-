{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-peptides.example/schema/universal-label-manifest.schema.json",
  "title": "LA Peptides Universal Label Manifest",
  "description": "Package-level table of contents — the entry point a consuming system should read first.",
  "type": "object",
  "required": ["manifestId", "templateId", "version", "canonicalSources", "editableRegionIds", "contentFieldIds"],
  "properties": {
    "manifestId": { "type": "string" },
    "templateId": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "canonicalSources": { "type": "object" },
    "profiles": { "type": "object" },
    "derivedDeliverables": { "type": "object" },
    "componentSystem": { "type": "object" },
    "examples": { "type": "object" },
    "placeholders": { "type": "object" },
    "schemas": { "type": "object" },
    "documentation": { "type": "object" },
    "buildTooling": { "type": "object" },
    "physicalSize": { "type": "object" },
    "orientation": { "type": "string" },
    "coordinateSystem": { "type": "object" },
    "safeArea": { "type": "object" },
    "bleed": { "type": "object" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
      }
    },
    "themeLayerCategories": { "type": "array", "items": { "type": "string" } },
    "editableRegionIds": { "type": "array", "items": { "type": "string" } },
    "contentFieldIds": { "type": "array", "items": { "type": "string" } },
    "requiredContentFieldIds": { "type": "array", "items": { "type": "string" } },
    "idConvention": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
