{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-peptides.example/schema/universal-label-components.schema.json",
  "title": "LA Peptides Universal Label Components",
  "description": "Derived, per-component view of every visible object in master-label.svg — generated by scripts/build-components.js as a join of label-spec.json and layout.json. Not hand-maintained.",
  "type": "object",
  "required": ["templateVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedFrom": { "type": "array", "items": { "type": "string" } },
    "templateVersion": { "type": "string" },
    "note": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "layer", "position", "locked"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "image", "shape", "use", "group"] },
          "layer": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "position": {
            "type": "object",
            "required": ["xPct", "yPct", "widthPct", "heightPct"],
            "properties": {
              "xPct": { "type": "number" },
              "yPct": { "type": "number" },
              "widthPct": { "type": "number" },
              "heightPct": { "type": "number" }
            }
          },
          "textAnchor": { "type": ["string", "null"] },
          "alignment": { "type": ["string", "null"] },
          "baselineYPct": { "type": ["number", "null"] },
          "locked": { "type": "boolean" },
          "defaultPlaceholder": { "type": ["string", "null"] },
          "autoFit": { "type": "object" },
          "field": {
            "type": ["object", "null"],
            "properties": {
              "fieldKey": { "type": "string" },
              "required": { "type": "boolean" },
              "maxLength": { "type": ["number", "null"] },
              "applyAs": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "themeTokens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "token": { "type": "string" }, "attr": { "type": "string" } }
            }
          },
          "fontRole": { "type": ["string", "null"], "enum": ["heading", "subheading", null] }
        }
      }
    }
  },
  "additionalProperties": false
}
