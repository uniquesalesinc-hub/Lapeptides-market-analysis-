{
  "$schema": "./schema/layout.schema.json",
  "templateId": "la-peptides-universal-label",
  "templateVersion": "1.1.0",
  "sourceFile": "./master-label.svg",
  "description": "Percentage-based coordinates for every editable region in master-label.svg, so a web application, the sales app, or a backend tool can position an overlay/editor or recompute pixel positions at any render resolution without parsing the SVG or redesigning the label. Every region's \"id\" is identical to its SVG element id and to its fieldKey in label-spec.json.",

  "canvas": {
    "widthPt": 127.44,
    "heightPt": 55.44,
    "widthPx300dpi": 531,
    "heightPx300dpi": 231,
    "aspectRatio": 2.29870
  },

  "coordinateSystem": {
    "origin": "top-left",
    "unit": "percent",
    "xAxis": "percent of canvas width (0-100)",
    "yAxis": "percent of canvas height (0-100)",
    "widthAxis": "percent of canvas width (0-100)",
    "heightAxis": "percent of canvas height (0-100)",
    "note": "width%/height% are computed against DIFFERENT absolute axes (canvas width vs. canvas height respectively), matching how CSS percentage sizing works on a fixed-aspect-ratio box. Because the canvas itself is not square (127.44 x 55.44pt), a square element's width% and height% are NOT equal (e.g. coa_qr is 18x18pt but reports width=14.124%, height=32.468%). This is correct: render the canvas at its true aspect ratio (any size proportional to 127.44:55.44, e.g. 531x231px) and converting each percentage back with widthPx = widthPct/100*canvasWidthPx, heightPx = heightPct/100*canvasHeightPx reproduces the exact original square. Do not derive a single 'scale factor' from width alone and apply it to height, or vice versa.",
    "textRegions": "For type=\"text\" regions, x/y/width/height describe the ALLOTTED box the field is safe to fill (matches the maxLength budget in label-spec.json's \"fields\"), not the as-drawn bounding box of the current placeholder string. baselineYPct is the SVG text baseline position (percent of canvas height) if you need to render actual SVG <text> rather than an HTML box. textAnchor \"middle\" means the field's text is horizontally centered within the region rather than left-aligned from x."
  },

  "panels": [
    { "id": "background_layer",   "label": "Background Layer" },
    { "id": "brand_panel",         "label": "Left Branding Panel" },
    { "id": "divider_layer",       "label": "Divider Layer" },
    { "id": "product_panel",       "label": "Product Panel" },
    { "id": "verification_panel",  "label": "Verification Panel" }
  ],

  "regions": [
