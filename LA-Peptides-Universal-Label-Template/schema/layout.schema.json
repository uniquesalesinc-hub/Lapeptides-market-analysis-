{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-peptides.example/schema/universal-label-layout.schema.json",
  "title": "LA Peptides Universal Label Layout",
  "description": "Percentage-based geometry for every editable region in master-label.svg. Region ids match label-spec.json fieldKeys/elementIds 1:1.",
  "type": "object",
  "required": ["templateId", "templateVersion", "canvas", "coordinateSystem", "regions"],
  "properties": {
    "templateId": { "type": "string" },
    "templateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sourceFile": { "type": "string" },
    "description": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["widthPt", "heightPt"],
      "properties": {
        "widthPt": { "type": "number" },
        "heightPt": { "type": "number" },
        "widthPx300dpi": { "type": "number" },
        "heightPx300dpi": { "type": "number" },
        "aspectRatio": { "type": "number" }
      }
    },
    "coordinateSystem": { "type": "object" },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "panel", "type", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "panel": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "image", "shape", "use", "group"] },
          "x": { "type": "number", "minimum": 0, "maximum": 100 },
          "y": { "type": "number", "minimum": 0, "maximum": 100 },
          "width": { "type": "number", "minimum": 0, "maximum": 100 },
          "height": { "type": "number", "minimum": 0, "maximum": 100 },
          "baselineYPct": { "type": "number" },
          "textAnchor": { "type": "string", "enum": ["start", "middle", "end"] }
        }
      }
    },
    "themeLayer": { "type": "object" }
  },
  "additionalProperties": false
}
