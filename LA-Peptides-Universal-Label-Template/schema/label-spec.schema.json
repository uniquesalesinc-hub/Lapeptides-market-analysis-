{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-peptides.example/schema/universal-label-spec.schema.json",
  "title": "LA Peptides Universal Label Spec",
  "type": "object",
  "required": ["templateId", "templateVersion", "sourceFile", "physicalSize", "coordinateSystem", "elements", "fields", "themeTargets"],
  "properties": {
    "templateId": { "type": "string" },
    "templateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sourceFile": { "type": "string" },
    "description": { "type": "string" },
    "physicalSize": {
      "type": "object",
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "unit": { "type": "string", "enum": ["in", "mm", "pt"] }
      }
    },
    "orientation": { "type": "string" },
    "margins": { "type": "string" },
    "cropMarks": { "type": "string" },
    "coordinateSystem": {
      "type": "object",
      "required": ["userUnitsPerInch", "viewBox"],
      "properties": {
        "userUnitsPerInch": { "type": "number" },
        "viewBox": { "type": "string" }
      }
    },
    "colorProfile": { "type": "object" },
    "fonts": { "type": "object" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "xRange": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "image", "shape", "group", "use"] },
          "role": { "type": "string" }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldKey", "elementId", "applyAs"],
        "properties": {
          "fieldKey": { "type": "string" },
          "elementId": { "type": "string" },
          "applyAs": { "type": "string", "enum": ["text", "attr:href", "attr:fill", "qr"] },
          "attrs": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "maxLength": { "type": "number" },
          "description": { "type": "string" }
        }
      }
    },
    "themeTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "elementId", "attr"],
        "properties": {
          "token": { "type": "string" },
          "elementId": { "type": "string" },
          "attr": { "type": "string" }
        }
      }
    },
    "fontTargets": { "type": "object" },
    "borderTokens": { "type": "object" },
    "qrCaptionStyle": { "type": "object" },
    "outputs": { "type": "object" }
  }
}
